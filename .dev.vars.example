# 로컬 개발용 시크릿: 이 파일을 .dev.vars 로 복사해서 사용하세요 (.dev.vars 는 git에 올라가지 않습니다)
# 운영 배포: npx wrangler secret put NEXON_API_KEY
# Nexon Open API 키 (https://openapi.nexon.com)
NEXON_API_KEY=

# Web Push VAPID 설정 (운영 VAPID_PRIVATE_KEY 는 wrangler secret put VAPID_PRIVATE_KEY 로 등록)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yunyun.page
