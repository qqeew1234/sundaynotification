{
  "name": "sundaynotification",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cf:types": "wrangler types",
    "typecheck": "tsc -b",
    "test": "node --test tests/nexon.test.ts",
